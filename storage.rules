rules_version = '2';

// Files are publicly readable (product images/videos). Only admins upload
// or delete from the client (app/admin/inventory/[id]/page.tsx).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
